execute if entity @s[tag=helper.tier1] run item replace entity @s weapon.mainhand with minecraft:wooden_sword[minecraft:enchantments={"minecraft:sharpness":1}]
execute if entity @s[tag=helper.tier2] run item replace entity @s weapon.mainhand with minecraft:iron_sword[minecraft:enchantments={"minecraft:sharpness":2,"minecraft:knockback":1},minecraft:unbreakable={}]
execute if entity @s[tag=helper.tier3] run item replace entity @s weapon.mainhand with minecraft:netherite_sword[minecraft:enchantments={"minecraft:sharpness":5,"minecraft:knockback":2,"minecraft:fire_aspect":2,"minecraft:unbreaking":3},minecraft:unbreakable={}]
execute unless entity @s[tag=helper.tier1] unless entity @s[tag=helper.tier2] unless entity @s[tag=helper.tier3] run item replace entity @s weapon.mainhand with minecraft:netherite_sword[minecraft:unbreakable={}]
