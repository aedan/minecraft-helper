# Golem Structure Guide: Shows players how to build each tier
# Run with: /helper golem_help

tellraw @a [{"text":"\n[HELPER GOLEM GUIDE]\n","color":"aqua","bold":true}]
tellraw @a [{"text":"Build a golem structure to summon your helper.\n","color":"gray"}]
tellraw @a [{"text":"\n--- TIER 1: STONE HELPER ---\n","color":"gray","bold":true}]
tellraw @a [{"text":"Materials: 4x Stone + 1x Carved Pumpkin\n","color":"white"}]
tellraw @a [{"text":"Structure:\n","color":"gray"}]
tellraw @a [{"text":"  [Pumpkin]\n","color":"orange"}]
tellraw @a [{"text":"  [Stone][Stone]\n","color":"gray"}]
tellraw @a [{"text":"  [Stone][Stone]\n","color":"gray"}]
tellraw @a [{"text":"Place pumpkin on top of 2x2 stone square.\n","color":"gray"}]
tellraw @a [{"text":"Reward: Wooden gear, 20 HP, basic combat.\n","color":"yellow"}]
tellraw @a [{"text":"\n--- TIER 2: IRON HELPER ---\n","color":"gray","bold":true}]
tellraw @a [{"text":"Materials: 4x Iron Block + 1x Carved Pumpkin\n","color":"white"}]
tellraw @a [{"text":"Structure:\n","color":"gray"}]
tellraw @a [{"text":"  [Pumpkin]\n","color":"orange"}]
tellraw @a [{"text":"  [Iron][Iron]\n","color":"gray"}]
tellraw @a [{"text":"  [Iron][Iron]\n","color":"gray"}]
tellraw @a [{"text":"Place pumpkin on top of 2x2 iron block square.\n","color":"gray"}]
tellraw @a [{"text":"Reward: Iron gear, 30 HP, sword + bow, fire immune.\n","color":"gold"}]
tellraw @a [{"text":"\n--- TIER 3: NETHERITE HELPER ---\n","color":"dark_purple","bold":true}]
tellraw @a [{"text":"Materials: 4x Netherite Block + 1x Carved Pumpkin + 1x Diamond Block\n","color":"white"}]
tellraw @a [{"text":"Structure:\n","color":"gray"}]
tellraw @a [{"text":"  [Diamond]\n","color":"aqua"}]
tellraw @a [{"text":"  [Pumpkin]\n","color":"orange"}]
tellraw @a [{"text":"  [Netherite][Netherite]\n","color":"dark_purple"}]
tellraw @a [{"text":"  [Netherite][Netherite]\n","color":"dark_purple"}]
tellraw @a [{"text":"Place diamond on top of pumpkin on top of 2x2 netherite square.\n","color":"gray"}]
tellraw @a [{"text":"Reward: Full netherite, max enchants, 40 HP, all tools, horse.\n","color":"gold"}]
tellraw @a [{"text":"\n[IMPORTANT]\n","color":"red","bold":true}]
tellraw @a [{"text":"- You can only have ONE helper at a time.\n","color":"white"}]
tellraw @a [{"text":"- Despawn with /helper despawn to summon a new tier.\n","color":"white"}]
tellraw @a [{"text":"- Higher tiers are harder to build but much more powerful.\n","color":"white"}]
tellraw @a [{"text":"\n","color":"gray"}]
