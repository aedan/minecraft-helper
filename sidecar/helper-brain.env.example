# OpenAI-compatible endpoint (Erebine, Ollama, LM Studio, xAI, …)
HELPER_LLM_BASE_URL=https://api.erebine.ai/proj_YOUR_PROJECT/v1
HELPER_LLM_API_KEY=ere_your_key
HELPER_LLM_MODEL=your-model-id
# Tool calling: auto (native tools, falls back to strict JSON if the server rejects them),
# native, or json (for models/servers without tool support).
HELPER_LLM_TOOL_MODE=auto
# Seconds the agent may spend on one order (all model calls together).
HELPER_LLM_TIMEOUT=20

# Minecraft RCON (defaults can be read from server.properties if unset)
HELPER_RCON_HOST=127.0.0.1
HELPER_RCON_PORT=25575
HELPER_RCON_PASSWORD=

# Server log to tail for chat
HELPER_LOG_PATH=/opt/minecraft/logs/latest.log

# Default name until a player says "I name you …"
HELPER_DEFAULT_NAME=Helper

# Names file (player -> helper name)
HELPER_NAMES_PATH=/opt/minecraft/helper-brain/names.json
